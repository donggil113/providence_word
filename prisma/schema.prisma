// 섭리 말씀 아카이브 데이터 모델
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 말씀의 종류 — 사용자가 직접 추가/수정할 수 있도록 테이블로 관리한다.
// (기본 11종은 seed 로 생성되며 isBuiltin=true. 그 외 분류는 관리자가 추가)
model Category {
  id        String   @id @default(cuid())
  code      String   @unique // 식별 코드(영문/대문자, CSV·필터에 사용)
  label     String // 화면 표시명(한글)
  color     String   @default("slate") // 뱃지 색상(팔레트 이름, lib/categories.ts 의 PALETTE)
  sortOrder Int      @default(100) // 표시 순서
  isBuiltin Boolean  @default(false) // 기본 분류(삭제 불가)
  sermons   Sermon[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("categories")
}

enum FileKind {
  TXT
  PDF
  HWP
  OTHER
}

enum Role {
  ADMIN  // 모든 권한 + 계정 관리
  EDITOR // 말씀 등록/수정/삭제
}

model Sermon {
  id          String   @id @default(cuid())
  title       String                       // 제목
  categoryId  String                       // 말씀 종류 (Category 참조)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department  String?                      // 부서명 (부서 말씀일 때)
  eventName   String?                      // 행사명 (성령집회/특별집회 등)
  preacher    String?                      // 설교자
  scripture   String?                      // 성경 본문 (예: 창세기 1:1-5)
  summary     String?                      // 요약 / 설명
  contentText String?                      // 검색용 본문 텍스트(txt/pdf에서 자동 추출)
  preachedAt  DateTime                     // 선포된 날짜
  year        Int                          // 선포 연도 (연도별 정렬/필터용, preachedAt 에서 파생)
  needsReview Boolean  @default(false)      // 검토 필요(자동 분석에서 애매했던 항목). 수정하면 해제

  files     SermonFile[]
  createdBy String?
  creator   User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([preachedAt])
  @@index([categoryId])
  @@index([year])
  @@index([department])
  @@index([needsReview])
  @@map("sermons")
}

model SermonFile {
  id           String   @id @default(cuid())
  sermon       Sermon   @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  sermonId     String
  originalName String                      // 원본 파일명
  storedName   String                      // 디스크에 저장된 파일명 (충돌 방지용 고유명)
  kind         FileKind                    // 파일 종류
  mimeType     String
  size         Int                         // 바이트
  createdAt    DateTime @default(now())

  @@index([sermonId])
  @@map("sermon_files")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  active       Boolean  @default(true)

  sermons   Sermon[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
