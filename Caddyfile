# 섭리 말씀 아카이브 - 리버스 프록시 + 자동 HTTPS (Caddy)
#
# 도메인은 .env 의 SITE_DOMAIN 값을 그대로 사용합니다. (예: providence-word.com)
# Let's Encrypt 인증서를 자동으로 발급/갱신하므로 별도 작업이 필요 없습니다.
{
	# 인증서 만료 알림을 받을 주소 (.env 의 ACME_EMAIL)
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# 웹 컨테이너로 전달 (compose 네트워크 내부 이름)
	reverse_proxy web:3000

	# 접속 로그 (docker compose logs caddy 로 확인)
	log {
		output stdout
		format console
	}
}

# www 로 들어와도 기본 주소로 넘겨준다.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
