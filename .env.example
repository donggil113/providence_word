# ─────────────────────────────────────────────────────────────
# 섭리 말씀 아카이브 환경변수 예시
# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채워주세요.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── 데이터베이스(PostgreSQL) ────────────────────────────────
# docker-compose 로 실행할 때는 host 가 'db' 입니다.
# 로컬에서 직접 실행할 때는 localhost 로 바꾸세요.
POSTGRES_USER=providence
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=providence_word

# 애플리케이션이 사용하는 연결 문자열
# (docker-compose 사용 시 host=db, 로컬 실행 시 host=localhost)
DATABASE_URL=postgresql://providence:change-this-strong-password@db:5432/providence_word?schema=public

# ── 인증 / 보안 ─────────────────────────────────────────────
# 세션 JWT 서명용 비밀키. 반드시 길고 무작위한 값으로 바꾸세요.
#   openssl rand -base64 48
AUTH_SECRET=please-generate-a-long-random-secret-string

# ── 최초 관리자 계정 (seed 시 생성) ─────────────────────────
# 첫 배포 후 반드시 비밀번호를 변경하거나 새 계정을 만드세요.
ADMIN_EMAIL=admin@providence.word.net
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=관리자

# ── 파일 저장 위치 ──────────────────────────────────────────
# 업로드된 말씀 파일(txt/pdf/hwp)이 저장되는 디렉터리.
UPLOAD_DIR=/app/uploads

# ── 사이트 정보 ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=섭리 말씀 아카이브
NEXT_PUBLIC_SITE_URL=https://providence-word.com

# ── 도메인 / HTTPS (운영 서버에서만 사용) ───────────────────
# docker-compose.prod.yml 의 Caddy 가 이 도메인으로 인증서를 자동 발급합니다.
# www 없이 적으세요. (www 로 들어와도 자동으로 이 주소로 넘어갑니다)
SITE_DOMAIN=providence-word.com
# 인증서 만료 알림을 받을 이메일
ACME_EMAIL=admin@example.com
